{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/setup/global.ts",
  "setupFiles": ["<rootDir>/setup/env.ts"],
  "testTimeout": 30000,
  "maxWorkers": 1,
  "forceExit": true
}
